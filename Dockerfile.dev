FROM golang:1.27.4-alpine@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf
LABEL maintainer="Ghostline maintainers"
WORKDIR /app
COPY --chown=65532:65532 go.mod go.sum ./
RUN go mod download
# The pinned base image does not ship these fixes yet; the version constraints fail
# the build if a fixed package cannot be installed.
# zlib: ALPINE-CVE-2026-4738 is fixed in 1.4-r0.
# OpenSSL: four Alpine advisories are fixed in 3.5.9-r1 (issue #78).
RUN apk add --no-cache 'zlib>=1.4-r0' 'libssl3>=3.5.9-r1' 'libcrypto3>=3.5.9-r1'
COPY --chown=65532:65532 backend ./backend
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /usr/local/bin/ghostline ./backend \
    && chown 65532:65532 /usr/local/bin/ghostline
ENV HOST=0.0.0.0 PORT=8080 HOME=/tmp GOCACHE=/tmp/go-cache
USER 65532:65532
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=6 --start-period=30s CMD ["/usr/local/bin/ghostline", "healthcheck"]
CMD ["/usr/local/bin/ghostline"]
