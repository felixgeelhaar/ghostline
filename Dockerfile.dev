FROM golang:1.27.4-alpine3.23@sha256:146e3b9c7c1e2ec3d3f5348c8a686151a75e1976e50efac9fc022ebe446a9a82
LABEL maintainer="Ghostline maintainers"
WORKDIR /app
# Upgrade the pinned builder's Alpine package before running project tools.
RUN apk add --no-cache 'zlib>=1.4-r0' \
    && apk version -t "$(apk info -v zlib | sed 's/^zlib-//')" 1.4-r0 | grep -Eq '^(>|=)$'
COPY --chown=65532:65532 go.mod go.sum ./
RUN go mod download
RUN apk add --no-cache curl
COPY --chown=65532:65532 backend ./backend
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /usr/local/bin/ghostline ./backend \
    && chown 65532:65532 /usr/local/bin/ghostline
ENV HOST=0.0.0.0 PORT=8080 HOME=/tmp GOCACHE=/tmp/go-cache
USER 65532:65532
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=6 --start-period=30s CMD curl -fsS http://localhost:8080/api/health || exit 1
CMD ["/usr/local/bin/ghostline"]
