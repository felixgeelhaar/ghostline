# Copy to .env.hosted and replace every value before starting the hosted container.
GHOSTLINE_BIND_ADDRESS=127.0.0.1
GHOSTLINE_PORT=8080
GITHUB_OAUTH_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_OAUTH_CALLBACK_URL=https://ghostline.example/auth/callback
# Generate a random session key of at least 32 bytes and provide it through the host secret manager.
# GHOSTLINE_SESSION_SECRET=<secret-manager-reference>
GHOSTLINE_ALLOWED_GITHUB_IDS=12345678
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=1m
# Set both when a trusted ingress overwrites the chosen client IP header.
RATE_LIMIT_CLIENT_IP_HEADER=
RATE_LIMIT_TRUSTED_PROXIES=
